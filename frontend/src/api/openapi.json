{
  "components": {
    "schemas": {
      "ExerciseKind": {
        "description": "How an exercise is measured.",
        "enum": [
          "reps",
          "seconds",
          "duration_min"
        ],
        "title": "ExerciseKind",
        "type": "string"
      },
      "ExerciseView": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ExerciseKind"
          },
          "ladder": {
            "items": {
              "type": "string"
            },
            "title": "Ladder",
            "type": "array"
          },
          "muscle_groups": {
            "items": {
              "type": "string"
            },
            "title": "Muscle Groups",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "per_side": {
            "title": "Per Side",
            "type": "boolean"
          },
          "rep_max": {
            "title": "Rep Max",
            "type": "integer"
          },
          "rep_min": {
            "title": "Rep Min",
            "type": "integer"
          },
          "sets": {
            "title": "Sets",
            "type": "integer"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "start_step": {
            "title": "Start Step",
            "type": "integer"
          }
        },
        "required": [
          "slug",
          "name",
          "kind",
          "sets",
          "rep_min",
          "rep_max",
          "per_side",
          "muscle_groups",
          "ladder",
          "start_step"
        ],
        "title": "ExerciseView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "bot_enabled": {
            "title": "Bot Enabled",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "bot_enabled"
        ],
        "title": "Health",
        "type": "object"
      },
      "Me": {
        "properties": {
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "Me",
        "type": "object"
      },
      "PlanView": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/SessionView"
            },
            "title": "Sessions",
            "type": "array"
          },
          "volume": {
            "items": {
              "$ref": "#/components/schemas/VolumeView"
            },
            "title": "Volume",
            "type": "array"
          },
          "volume_target_max": {
            "title": "Volume Target Max",
            "type": "integer"
          },
          "volume_target_min": {
            "title": "Volume Target Min",
            "type": "integer"
          }
        },
        "required": [
          "sessions",
          "volume",
          "volume_target_min",
          "volume_target_max"
        ],
        "title": "PlanView",
        "type": "object"
      },
      "Redeem": {
        "properties": {
          "token": {
            "maxLength": 100,
            "minLength": 20,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "Redeem",
        "type": "object"
      },
      "SessionView": {
        "properties": {
          "exercises": {
            "items": {
              "$ref": "#/components/schemas/ExerciseView"
            },
            "title": "Exercises",
            "type": "array"
          },
          "focus": {
            "title": "Focus",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "optional": {
            "title": "Optional",
            "type": "boolean"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "total_sets": {
            "title": "Total Sets",
            "type": "integer"
          },
          "type": {
            "enum": [
              "strength",
              "conditioning",
              "recovery"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "position",
          "slug",
          "name",
          "focus",
          "type",
          "optional",
          "total_sets",
          "exercises"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VolumeView": {
        "properties": {
          "group": {
            "title": "Group",
            "type": "string"
          },
          "sets": {
            "title": "Sets",
            "type": "integer"
          }
        },
        "required": [
          "group",
          "sets"
        ],
        "title": "VolumeView",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Training Coach",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/me": {
      "get": {
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/redeem": {
      "post": {
        "description": "Exchange a one-time link from the bot for a session cookie.",
        "operationId": "redeem_api_auth_redeem_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Redeem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Redeem",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/signout": {
      "post": {
        "description": "End this browser's session. Harmless without one.",
        "operationId": "signout_api_auth_signout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Signout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/plan": {
      "get": {
        "operationId": "get_plan_api_plan_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Plan",
        "tags": [
          "plan"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "ops"
        ]
      }
    }
  }
}

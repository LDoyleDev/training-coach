# Copy to .env (never commit it). All variables use the TC_ prefix.
# Rotation: docs/runbooks/rotate-secrets.md

# development | test | production. The Docker image sets production; leave this commented on the Pi.
# TC_ENVIRONMENT=development
TC_LOG_LEVEL=INFO
TC_TIMEZONE=Europe/Berlin

# SQLite file. Local dev only: the Docker image sets /data/training_coach.db (the mounted
# volume), and a relative path here would override it and point at the read-only image.
# TC_DATABASE_URL=sqlite:///./data/training_coach.db

# Telegram: token from @BotFather; your numeric user ID from @userinfobot.
# The bot only starts when both are set, and only ever answers this user ID.
TC_TELEGRAM_BOT_TOKEN=
TC_TELEGRAM_ALLOWED_USER_ID=

# Groq: transcription + fallback parsing. Use a key dedicated to this project.
TC_GROQ_API_KEY=
# Speech-to-text model; change only if Groq retires it (console.groq.com/docs/speech-to-text).
# TC_GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Model that rereads logs the rules cannot; must support strict JSON-schema output
# (console.groq.com/docs/structured-outputs).
# TC_GROQ_PARSE_MODEL=openai/gpt-oss-20b

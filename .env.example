# Copy to .env (never commit it). All variables use the TC_ prefix.
# Rotation: docs/runbooks/rotate-secrets.md

TC_ENVIRONMENT=development          # development | test | production
TC_LOG_LEVEL=INFO
TC_TIMEZONE=Europe/Berlin

# SQLite file. In Docker this is /data/training_coach.db (mounted volume).
TC_DATABASE_URL=sqlite:///./data/training_coach.db

# Telegram: token from @BotFather; your numeric user ID from @userinfobot.
# The bot only starts when both are set, and only ever answers this user ID.
TC_TELEGRAM_BOT_TOKEN=
TC_TELEGRAM_ALLOWED_USER_ID=

# Groq: transcription + fallback parsing. Use a key dedicated to this project.
TC_GROQ_API_KEY=

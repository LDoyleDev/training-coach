# Deploys the newest release tag if the Pi isn't on it (ADR-0030). Started by the timer.
# Install: docs/runbooks/deploy.md, "Automatic deploys". Paths assume the vybe user's checkout.
[Unit]
# A failure tells Liam on Telegram (training-coach-alert@.service).
OnFailure=training-coach-alert@%n.service
Description=Deploy the newest Training Coach release
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=vybe
WorkingDirectory=/home/vybe/training-coach
ExecStart=/home/vybe/training-coach/scripts/auto-deploy.sh
Environment=TC_HEALTH_URL=http://127.0.0.1:8095/healthz
# A rebuild on the Pi takes minutes; a hung one shouldn't block the next run forever.
TimeoutStartSec=30min
Nice=10
